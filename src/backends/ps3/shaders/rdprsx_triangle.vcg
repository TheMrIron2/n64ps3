void main(float4 position : POSITION,
          float4 color : COLOR,
          float2 texcoord : TEXCOORD0,
          out float4 clipPosition : POSITION,
          out float4 vertexColor : COLOR,
          out float2 outputTexcoord : TEXCOORD0)
{
    clipPosition = position;
    vertexColor = color;
    outputTexcoord = texcoord;
}
